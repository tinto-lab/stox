.env
.venv/
__pycache__/
*.pyc
.idea/
.pytest_cache/
.DS_Store

# macapp (Electron): dependencies and build output are regenerated by
# `npm install` / `npm run build` / `npm run package:mac` -- only source
# and package-lock.json are tracked.
macapp/node_modules/
macapp/out/
macapp/dist/
macapp/backend/
macapp/*.tsbuildinfo

# PyInstaller build output for the standalone backend (scripts/build_backend.sh
# regenerates these into macapp/backend/, which is also git-ignored above).
/build/
/dist/
