.env
.idea/
.DS_Store

# Dependencies and build output are regenerated by `npm install` /
# `npm run build` / `npm run package:mac` / `npm run build:cli` -- only
# source and package-lock.json are tracked.
node_modules/
out/
dist/
*.tsbuildinfo
# Bun leaves temp files behind when `npm run build:cli` compiles the binary.
.*.bun-build
