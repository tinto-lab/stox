.env
.idea/
.DS_Store

# macapp/: dependencies and build output are regenerated by `npm install` /
# `npm run build` / `npm run package:mac` -- only source and
# package-lock.json are tracked.
macapp/node_modules/
macapp/out/
macapp/dist/
macapp/*.tsbuildinfo
# Bun leaves temp files behind when `npm run build:cli` compiles the binary.
macapp/.*.bun-build
