.env
.idea/
.DS_Store

# Dependencies and build output are regenerated by `npm install` /
# `npm run build` / `npm run package:mac` / `npm run build:cli` -- only
# source and package-lock.json are tracked.
node_modules/
out/
dist/
*.tsbuildinfo
# Bun leaves temp files behind when it compiles the binary; `npm run
# build:cli` deletes them, a bare `bun build --compile` does not.
.*.bun-build
