# Copy this file to .env (project-local) or ~/.config/stox/.env (user-wide)
# and fill in the keys you need. Both are loaded automatically on startup --
# no more `export`ing in every new shell. A real `export`ed env var always
# takes priority over these files.

EODHD_API_KEY=demo

# Only needed for geopolitical/macro news (get_geopolitical_news, and the
# /analyze geopolitics agent). Get a key from webz.io.
# WEBZ_API_KEY=

# Only needed for plain-English questions. Pick one provider:
STOX_LLM_PROVIDER=deepseek
# STOX_LLM_MODEL=claude-opus-5   # optional, each provider has a default
#ANTHROPIC_API_KEY=

# STOX_LLM_PROVIDER=deepseek
 DEEPSEEK_API_KEY=

# STOX_LLM_PROVIDER=openai
# OPENAI_API_KEY=
