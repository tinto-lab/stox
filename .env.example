# Copy this file to .env (repo root, read by ./stox and `npm run dev`) or to
# ~/.config/stox/.env (user-wide -- the app's Settings panel edits this one)
# and fill in the keys you need. A real `export`ed env var always takes
# priority over these files; the repo-root file wins over the user-wide one.

EODHD_API_KEY=demo

# Only needed for plain-English questions, /analyze and news monitors.
# Pick one provider:
# STOX_LLM_PROVIDER=anthropic
# STOX_LLM_MODEL=claude-opus-5   # optional, each provider has a default
# ANTHROPIC_API_KEY=

STOX_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# STOX_LLM_PROVIDER=openai
# OPENAI_API_KEY=

# News monitor alerts over WhatsApp (see README):
# CALLMEBOT_PHONE=+14155550123
# CALLMEBOT_APIKEY=
# STOX_MONITOR_INTERVAL_MIN=10
