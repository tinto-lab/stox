{
  "name": "stox-app",
  "version": "0.1.0",
  "private": true,
  "description": "Stox: a stock price and fundamentals dashboard (macOS app) with a research chat panel, plus the stox terminal CLI. Both run on the TypeScript core in src/core/.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "stop": "scripts/kill_app.sh",
    "package:mac": "npm run stop && electron-vite build && electron-builder --mac && codesign --force --deep --sign - dist/mac-arm64/Stox.app",
    "relaunch": "npm run package:mac && open dist/mac-arm64/Stox.app",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "cli": "bun src/cli/index.ts",
    "build:cli": "bun build src/cli/index.ts --compile --minify --outfile dist/stox && rm -f .*.bun-build",
    "fetch:llama": "scripts/fetch-llama.sh"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.13",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.stox.app",
    "productName": "Stox",
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "identity": null,
      "target": "dir",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Stox uses the microphone for voice dictation in the research chat. Audio is transcribed on this Mac and never leaves it."
      }
    },
    "extraResources": [
      {
        "from": "build/bin/llama-server",
        "to": "bin/llama-server"
      }
    ]
  }
}
